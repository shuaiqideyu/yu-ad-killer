# 与 internal/config 中 Load() 对应；克隆后可直接改本文件部署
BOT_TOKEN=<your_bot_token>
BOT_ADMIN_ID=<your_admin_user_id>
# 工作群可选, 不填则需通过主 Bot 私聊 /admin 在面板里绑定
BOT_WORK_GROUP_ID=

SQLITE_PATH=data/chavipbot.db
# 克隆 Bot 数据库目录(每个克隆 Bot 一个独立 SQLite 文件)
CLONE_DB_DIR=data/clones

APP_LOG_LEVEL=info
APP_CACHE_PREFIX=tgban:
APP_WORKER_POOL_SIZE=100

